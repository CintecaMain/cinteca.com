# SMTP connection
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=

# Message routing
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL_CINTECA=web-cinteca@cinteca.es
CONTACT_FROM_EMAIL_AC=web-ac@cinteca.es

# Cloudflare Turnstile (secret: Lambda only)
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_ACTION=contact
TURNSTILE_EXPECTED_HOSTNAMES=cinteca.es,www.cinteca.es,cinteca-es.acmc.chatgpt.site,adrianocaldas.com,www.adrianocaldas.com

# Exact origins allowed to invoke the Lambda URL
ALLOWED_ORIGINS=https://cinteca.es,https://www.cinteca.es,https://cinteca-es.acmc.chatgpt.site,https://adrianocaldas.com,https://www.adrianocaldas.com
