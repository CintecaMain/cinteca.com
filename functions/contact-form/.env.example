# Outside the platform (local test): the Lambda's names. On the platform (General) only the CINTECA_CONTACT_ names
# count; see README.md.

# SMTP connection
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=

# Message routing
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL_CINTECA=web-cinteca@cinteca.es
CONTACT_FROM_EMAIL_AC=web-ac@cinteca.es

# Cloudflare Turnstile (secret: function only)
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_ACTION=contact
TURNSTILE_EXPECTED_HOSTNAMES=cinteca.es,www.cinteca.es,adrianocaldas.com,www.adrianocaldas.com

# Exact origins allowed to call the function
ALLOWED_ORIGINS=https://cinteca.es,https://www.cinteca.es,https://adrianocaldas.com,https://www.adrianocaldas.com
